{
  "label": "PrimeKG Migraine Graph RAG",
  "description": "Demo workflow for querying a filtered PrimeKG migraine subgraph imported into Neo4j.",
  "workflow": {
    "nodes": [
      {
        "id": "input-1",
        "type": "input",
        "label": "Migraine Question",
        "position": { "x": 60, "y": 205 },
        "config": {
          "text": "What drugs are connected to migraine?"
        }
      },
      {
        "id": "vector-1",
        "type": "vector_db",
        "label": "Optional Biomedical Notes",
        "position": { "x": 290, "y": 320 },
        "config": {
          "collection": "primekg_migraine_demo",
          "vectorBackend": "local-json-fallback",
          "embeddingModel": "nomic-embed-text",
          "baseUrl": "http://127.0.0.1:11434",
          "graphEnabled": true
        }
      },
      {
        "id": "retriever-1",
        "type": "retriever",
        "label": "PrimeKG Graph Retriever",
        "position": { "x": 315, "y": 165 },
        "config": {
          "collection": "primekg_migraine_demo",
          "retrievalMode": "hybrid",
          "vectorBackend": "local-json-fallback",
          "embeddingModel": "nomic-embed-text",
          "baseUrl": "http://127.0.0.1:11434",
          "topK": 3,
          "graphDisease": "migraine",
          "graphHops": 2,
          "graphTopK": 8,
          "primekgAllowedNodeTypes": [
            "disease",
            "drug",
            "gene/protein",
            "pathway",
            "biological_process",
            "molecular_function",
            "phenotype"
          ],
          "graphEnabled": true
        }
      },
      {
        "id": "agent-1",
        "type": "agent",
        "label": "Biomedical Evidence Synthesizer",
        "position": { "x": 575, "y": 165 },
        "config": {
          "name": "Biomedical Evidence Synthesizer",
          "provider": "ollama",
          "model": "llama3.2:1b",
          "baseUrl": "http://127.0.0.1:11434",
          "temperature": 0.2,
          "think": false,
          "systemPrompt": "Write a human-readable biomedical research answer using PrimeKG graph evidence. Start with 1 short paragraph, then bullet points grouped by disease/concept. Cite paths like [Path 1]. Do not print grounding rules, detected intent, raw retriever status, unresolved mention dumps, or setup diagnostics. If graph evidence paths are present, never say setup, ingestion, retriever, or Neo4j is missing. For indication relations, say the drug is connected by PrimeKG indication evidence; for contraindication, explicitly say it is not treatment evidence. Include that this is biomedical research exploration, not medical advice."
        }
      },
      {
        "id": "output-1",
        "type": "output",
        "label": "PrimeKG Graph RAG Answer",
        "position": { "x": 850, "y": 205 },
        "config": {}
      }
    ],
    "edges": [
      { "source": "input-1", "target": "retriever-1" },
      { "source": "vector-1", "target": "retriever-1" },
      { "source": "retriever-1", "target": "agent-1" },
      { "source": "agent-1", "target": "output-1" }
    ]
  }
}
