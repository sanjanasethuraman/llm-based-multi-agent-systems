{
  "label": "MCP Tool Demo",
  "description": "Uses a live local LLM agent to write a demo note.",
  "workflow": {
    "nodes": [
      {
        "id": "input-1",
        "type": "input",
        "label": "Demo Brief",
        "position": { "x": 60, "y": 205 },
        "config": {
          "text": "Prepare a short demo note for a visual multi-agent systems presentation."
        }
      },
      {
        "id": "agent-1",
        "type": "agent",
        "label": "Demo Writer",
        "position": { "x": 540, "y": 205 },
        "config": {
          "name": "Demo Writer",
          "provider": "ollama",
          "model": "llama3.2:1b",
          "baseUrl": "http://127.0.0.1:11434",
          "temperature": 0.2,
          "think": false,
          "systemPrompt": "Write a concise demo summary from the brief."
        }
      },
      {
        "id": "output-1",
        "type": "output",
        "label": "Demo Output",
        "position": { "x": 780, "y": 205 },
        "config": {}
      }
    ],
    "edges": [
      { "source": "input-1", "target": "agent-1" },
      { "source": "agent-1", "target": "output-1" }
    ]
  }
}
